# ==============================================================================
# PTI & Hostel Management System — Zero-Cost BaaS Environment Configuration
# Copy this file to `.env.local` for local runs, or add these variables in Vercel
# Project Settings -> Environment Variables.
# ==============================================================================

# Active BaaS Provider: "firebase" | "supabase" | "local" (auto-detected if omitted)
VITE_BAAS_PROVIDER=firebase

# ------------------------------------------------------------------------------
# OPTION A: Firebase (Google Spark Free Tier — Auth + Cloud Firestore + Storage)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ------------------------------------------------------------------------------
# OPTION B: Supabase (Free Tier Alternative — PostgreSQL + PostgREST + Auth)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your_project_ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
